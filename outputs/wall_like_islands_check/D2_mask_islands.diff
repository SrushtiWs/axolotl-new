+def drop_islands(floor: np.ndarray, wall: np.ndarray, objects: np.ndarray, max_fraction: float):
+    """
+    (floor, wall, report): each mask without the pieces that are visible after
+    `objects` is erased but smaller than `max_fraction` of the frame -- object
+    pixels the object masks missed. Only ever removes pixels.
+    """
+    limit = max_fraction * floor.size
+    report = {"limit_px": int(limit)}
+    out = []
+    for name, mask in (("floor", floor), ("wall", wall)):
+        visible = mask & ~objects
+        count, labels, stats, _ = cv2.connectedComponentsWithStats(visible.astype(np.uint8), connectivity=8)
+        small = np.zeros(count, bool)
+        small[1:] = stats[1:, cv2.CC_STAT_AREA] < limit
+        island = small[labels]
+        out.append(mask & ~island)
+        report[name] = {"islands": int(small.sum()), "pixels": int(island.sum())}
+    return out[0], out[1], report
 
 
