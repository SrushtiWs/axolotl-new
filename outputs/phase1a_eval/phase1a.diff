+# ---------------------------------------------------------------------------
+# The wall, checked against the original photograph. Every step here only
+# removes wall pixels (an override include may add wall, never floor), after
+# the floor is final. Constants: extraction/config.py.
+
+def _polygon_fit(mask: np.ndarray) -> np.ndarray:
+    """Each glass / mirror region redrawn as its approxPolyDP polygon."""
+    out = np.zeros(mask.shape, np.uint8)
+    smallest = wall_rules.GLASS_POLYGON_MIN_FRACTION * mask.size
+    contours, _ = cv2.findContours(mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+    for contour in contours:
+        if cv2.contourArea(contour) < smallest:
+            continue
+        epsilon = wall_rules.GLASS_POLYGON_EPSILON * cv2.arcLength(contour, True)
+        cv2.fillPoly(out, [cv2.approxPolyDP(contour, epsilon, True)], 1)
+    return out > 0
+
+
+def _photo_classes(photo: np.ndarray, shape: tuple[int, int]) -> dict:
+    """The photo's class evidence at `shape`: object, off-wall and glass maps, and the class ids used."""
+    session, labels = surfaces._load()
+    probs = session.run(None, {session.get_inputs()[0].name: surfaces._preprocess(photo)})[0][0].astype(np.float32)
+    probs -= probs.max(axis=0, keepdims=True)
+    np.exp(probs, out=probs)
+    probs /= probs.sum(axis=0, keepdims=True)
+
+    names = {i: label.strip() for i, label in labels.items()}
+    wanted = (wall_rules.WALL_FLAT_DECOR_CLASSES | wall_rules.WALL_OPENING_CLASSES
+              | wall_rules.WALL_GLASS_MIRROR_CLASSES)
+    ids = {name: i for i, name in names.items() if name in wanted}
+
+    def group(classes):
+        rows = [i for i, name in names.items() if name in classes]
+        return probs[rows].sum(axis=0) if rows else np.zeros(probs.shape[1:], np.float32)
+
+    surface = FLOOR_CLASSES | WALL_CLASSES | frozenset({"ceiling"})
+    best_surface = np.maximum(group(WALL_CLASSES), group(FLOOR_CLASSES))
+    planes = {
+        "object": group(set(names.values()) - surface) >= wall_rules.WALL_OBJECT_SHARE,
+        "off_wall": group(wall_rules.WALL_FLAT_DECOR_CLASSES | wall_rules.WALL_OPENING_CLASSES) > best_surface,
+        "glass": group(wall_rules.WALL_GLASS_MIRROR_CLASSES) > best_surface,
+    }
+    height, width = shape
+    full = {k: cv2.resize(v.astype(np.uint8), (width, height), interpolation=cv2.INTER_NEAREST) > 0
+            for k, v in planes.items()}
+    full["glass"] = _polygon_fit(full["glass"])
+    full["class_ids"] = dict(sorted(ids.items()))
+    full["missing_classes"] = sorted(wanted - set(ids))
+    return full
+
+
+def _polygons(items, shape) -> np.ndarray:
+    height, width = shape
+    out = np.zeros(shape, np.uint8)
+    for poly in items or []:
+        pts = np.round(np.asarray(poly, np.float64) * [width, height]).astype(np.int32)
+        if len(pts) >= 3:
+            cv2.fillPoly(out, [pts], 1)
+    return out > 0
 
 
+def load_override(directory: Path) -> dict | None:
+    """The job's wall override file, or None. An unreadable file is reported, never guessed at."""
+    path = Path(directory) / wall_rules.WALL_OVERRIDE_FILENAME
+    if not path.exists():
+        return None
+    try:
+        data = json.loads(path.read_text("utf-8"))
+    except (OSError, ValueError) as error:
+        return {"error": f"{path.name}: {error}"}
+    return data if isinstance(data, dict) else {"error": f"{path.name}: not a JSON object"}
+
+
+def _wall_from_photo(wall, wall_before_tidy, floor, photo, objects, override, shape):
+    """(wall, glass mask or None, report). See the section comment above."""
+    report: dict = {}
+    glass = None
+    evidence = None
+    if photo is not None:
+        evidence = _photo_classes(np.ascontiguousarray(photo, dtype=np.uint8), shape)
+        report["class_ids"] = evidence["class_ids"]
+        report["missing_classes"] = evidence["missing_classes"]
+
+        # Pixels the tidy / refine added to the wall that the photo calls an
+        # object: a sealed hole made of an object stays open.
+        added = wall & ~wall_before_tidy
+        count, labels = cv2.connectedComponents(added.astype(np.uint8))
+        object_share = np.bincount(labels.ravel(), weights=evidence["object"].ravel(), minlength=count) / \
+            np.maximum(np.bincount(labels.ravel(), minlength=count), 1)
+        reopen = (object_share >= wall_rules.WALL_OBJECT_SHARE)[labels] & added
+        glass = evidence["glass"]
+        off = (evidence["off_wall"] | glass) & wall & ~reopen
+        wall = wall & ~reopen & ~off
+        report.update({"reopened_pixels": int(reopen.sum()), "excluded_pixels": int(off.sum()),
+                       "glass_mirror_pixels": int(glass.sum())})
+
+    if override:
+        report["override"] = {k: len(override.get(k) or []) for k in ("wall_include", "wall_exclude")}
+        if "error" in override:
+            report["override"]["error"] = override["error"]
+        include = _polygons(override.get("wall_include"), shape) & ~floor
+        exclude = _polygons(override.get("wall_exclude"), shape)
+        wall = (wall | include) & ~exclude
+
+    if evidence is not None:
+        covered = objects if objects is not None and objects.shape == shape else np.zeros(shape, bool)
+        leftover = wall & evidence["object"] & ~covered
+        share = float(leftover.sum()) / max(1, int(wall.sum()))
+        if share <= wall_rules.WALL_STATUS_CONFIRMED_LEFTOVER:
+            status = "confirmed"
+        elif share <= wall_rules.WALL_STATUS_APPROXIMATE_LEFTOVER:
+            status = "approximate"
+        else:
+            status = "needs_review"
+        reason = (f"{share:.2%} of the wall is an object in the photo that no object layer covers "
+                  f"(confirmed <= {wall_rules.WALL_STATUS_CONFIRMED_LEFTOVER:.0%}, "
+                  f"approximate <= {wall_rules.WALL_STATUS_APPROXIMATE_LEFTOVER:.0%})")
+        if report.get("missing_classes"):
+            status, reason = "needs_review", reason + f"; classes missing from the model: {report['missing_classes']}"
+        if override and "error" in override:
+            status, reason = "needs_review", reason + f"; override unreadable: {override['error']}"
+        report["status"] = {"status": status, "reason": reason, "leftover_share": round(share, 5),
+                            "override_applied": bool(override) and "error" not in override}
+    return wall, glass, report
+
