+# ---------------------------------------------------------------------------
+# Wall mask (floor_wall.py), read from the ORIGINAL photograph: once the
+# objects around them are inpainted, SegFormer reads what is left of a window
+# frame, a painting or a door as wall. These only ever take pixels OFF the
+# wall, after the floor is final; the floor is never touched.
+# ---------------------------------------------------------------------------
+
+# ADE20K classes taken off the wall and never tiled. Names, not ids: each is
+# looked up in the loaded model's own label map, and a missing one is reported.
+WALL_FLAT_DECOR_CLASSES: frozenset[str] = frozenset({"painting", "poster", "bulletin board"})
+WALL_OPENING_CLASSES: frozenset[str] = frozenset({"door", "blind"})
+
+# Glass and mirrors: also written as their own mask, each region polygon-fitted.
+WALL_GLASS_MIRROR_CLASSES: frozenset[str] = frozenset({"windowpane", "glass", "mirror", "screen door"})
+
+# approxPolyDP tolerance as a share of each glass region's own perimeter, and
+# the smallest glass region fitted, as a share of the frame.
+GLASS_POLYGON_EPSILON = 0.01
+GLASS_POLYGON_MIN_FRACTION = 0.001
+
+# A pixel is an object in the photo when the classes that are not floor, wall
+# or ceiling hold at least this probability together. Also the share of a
+# sealed hole that must be object for the hole to be reopened.
+WALL_OBJECT_SHARE = 0.5
+
+# Wall status from the leftover share: final wall pixels the photo calls an
+# object and no object layer covers (they would be tiled over).
+WALL_STATUS_CONFIRMED_LEFTOVER = 0.01
+WALL_STATUS_APPROXIMATE_LEFTOVER = 0.03
+
+# Manual override: one data file per job beside the masks, read the same way
+# for every room, never code:
+#   {"wall_exclude": [[[x, y], ...], ...], "wall_include": [[[x, y], ...], ...]}
+# x and y are fractions of the image width and height (0..1). An include never
+# takes floor pixels.
+WALL_OVERRIDE_FILENAME = "wall_override.json"
 
 
